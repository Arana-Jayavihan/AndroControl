<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ================= Base application theme (DARK) ================= -->
    <!-- Token colors resolve from values-night/colors.xml; component styles
         (shapes, keys, cards…) are shared from values/themes.xml. -->
    <style name="Base.Theme.AndroControl" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Tertiary / accent -->
        <item name="colorTertiary">@color/accent</item>
        <item name="colorTertiaryContainer">@color/accent_container</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorOnTertiaryContainer">@color/on_accent_container</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AndroControl.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AndroControl.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.AndroControl.Large</item>

        <!-- Edge-to-edge: transparent system bars, light icons on dark bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Dialogs pick up brand rounding -->
        <item name="alertDialogTheme">@style/ThemeOverlay.AndroControl.Dialog</item>
    </style>

    <style name="Theme.AndroControl" parent="Base.Theme.AndroControl" />
</resources>
