<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ===================== Main Content ===================== -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/ic_menu"
                app:title="@string/app_name"
                app:titleTextColor="@color/text_primary"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"/>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Connection Status Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusBar"
            style="@style/Widget.AndroControl.StatusPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="@color/success_container"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="11dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/status_connected"
                    android:textColor="@color/success"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/latencyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/success"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weighted content -->
        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- ===================== Touchpad (edges double as scroll zones) ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/touchpad_stroke"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/touchPad"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:filterTouchesWhenObscured="true"
                        android:background="@drawable/touchpad_modern_bg"/>

                    <!-- Edge scroll-zone indicators (visual only; touches pass through to the
                         touchpad, which decides scroll-vs-move from the touch position). -->
                    <View
                        android:id="@+id/scrollZoneLeft"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="@drawable/scroll_zone_bg"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone"/>

                    <View
                        android:id="@+id/scrollZoneRight"
                        android:layout_width="28dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:background="@drawable/scroll_zone_bg"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone"/>

                    <!-- Non-interactive hint overlay (lets touches pass through) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:alpha="0.55">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_touchpad"
                            android:contentDescription="@string/touchpad_title"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/touchpad_title"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/touchpad_hint"
                            android:textColor="@color/text_disabled"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Mouse Buttons (directly below touchpad) ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeftClick"
                    style="@style/Widget.AndroControl.Button.Mouse.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:filterTouchesWhenObscured="true"
                    android:text="@string/mouse_left"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiddleClick"
                    style="@style/Widget.AndroControl.Button.Mouse"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:filterTouchesWhenObscured="true"
                    android:text="@string/mouse_middle"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRightClick"
                    style="@style/Widget.AndroControl.Button.Mouse"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:filterTouchesWhenObscured="true"
                    android:text="@string/mouse_right"/>
            </LinearLayout>

            <!-- ===================== Control Button Row ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleKeyboard"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/btn_onscreen_keyboard"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_keyboard"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSystemKeyboard"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="8dp"
                    android:text="@string/btn_system_keyboard"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_smartphone"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReconnect"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="@string/btn_reconnect"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="18dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="14dp"/>
            </LinearLayout>

            <!-- Invisible text input for the system keyboard (receives focus but not visible).
                 Kept outside the on-screen keyboard panel so the system keyboard can be
                 shown independently of the on-screen QWERTY panel. -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:inputType="text"
                android:imeOptions="actionNone|flagNoEnterAction"
                android:background="@null"/>

            <!-- ===================== On-screen Keyboard Panel ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/keyboardPanel"
                style="@style/Widget.AndroControl.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Function Keys (scrollable) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF1" style="@style/Widget.AndroControl.Key.Function" android:text="F1"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF2" style="@style/Widget.AndroControl.Key.Function" android:text="F2"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF3" style="@style/Widget.AndroControl.Key.Function" android:text="F3"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF4" style="@style/Widget.AndroControl.Key.Function" android:text="F4"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF5" style="@style/Widget.AndroControl.Key.Function" android:text="F5"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF6" style="@style/Widget.AndroControl.Key.Function" android:text="F6"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF7" style="@style/Widget.AndroControl.Key.Function" android:text="F7"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF8" style="@style/Widget.AndroControl.Key.Function" android:text="F8"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF9" style="@style/Widget.AndroControl.Key.Function" android:text="F9"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF10" style="@style/Widget.AndroControl.Key.Function" android:text="F10"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF11" style="@style/Widget.AndroControl.Key.Function" android:text="F11"/>
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnF12" style="@style/Widget.AndroControl.Key.Function" android:text="F12"/>
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Number Keys Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum1" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="1"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum2" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="2"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum3" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="3"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum4" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="4"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum5" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="5"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum6" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="6"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum7" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="7"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum8" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="8"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum9" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="9"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnNum0" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="0"/>
                    </LinearLayout>

                    <!-- QWERTY Row 1: Q-P -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnQ" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="Q"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnW" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="W"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnE" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="E"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnR" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="R"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnT" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="T"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnY" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="Y"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnU" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="U"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnI" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="I"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnO" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="O"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnP" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="P"/>
                    </LinearLayout>

                    <!-- QWERTY Row 2: A-L -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:paddingHorizontal="12dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnA" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="A"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnS" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="S"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnD" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="D"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnF" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="F"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnG" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="G"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnH" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="H"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnJ" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="J"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnK" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="K"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnL" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="L"/>
                    </LinearLayout>

                    <!-- QWERTY Row 3: Z-M with Backspace -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnZ" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="Z"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnX" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="X"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnC" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="C"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnV" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="V"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnB" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="B"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnN" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="N"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnM" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:text="M"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBackspace" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1.5" android:text="@string/key_backspace" android:textSize="16sp"/>
                    </LinearLayout>

                    <!-- Space bar and Enter row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpace" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="4" android:text="@string/key_space" android:textSize="12sp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnter" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1.5" android:text="@string/key_enter" android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Modifier Keys Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="8dp">

                        <ToggleButton android:id="@+id/btnCtrl" style="@style/Widget.AndroControl.Toggle" android:layout_width="0dp" android:layout_weight="1" android:textOn="@string/key_ctrl" android:textOff="@string/key_ctrl"/>
                        <ToggleButton android:id="@+id/btnAlt" style="@style/Widget.AndroControl.Toggle" android:layout_width="0dp" android:layout_weight="1" android:textOn="@string/key_alt" android:textOff="@string/key_alt"/>
                        <ToggleButton android:id="@+id/btnShift" style="@style/Widget.AndroControl.Toggle" android:layout_width="0dp" android:layout_weight="1" android:textOn="@string/key_shift" android:textOff="@string/key_shift"/>
                        <ToggleButton android:id="@+id/btnWin" style="@style/Widget.AndroControl.Toggle" android:layout_width="0dp" android:layout_weight="1" android:textOn="@string/key_win" android:textOff="@string/key_win"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnTab" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_tab" android:textSize="10sp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEsc" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_esc" android:textSize="10sp"/>
                    </LinearLayout>

                    <!-- Navigation row: Home / Up / End / Del -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnHome" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_home" android:textSize="10sp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnUp" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_arrow_up"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnd" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_end" android:textSize="10sp"/>
                        <View android:layout_width="8dp" android:layout_height="1dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDel" style="@style/Widget.AndroControl.Key.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_del" android:textSize="10sp"/>
                    </LinearLayout>

                    <!-- Navigation row: Left / Down / Right -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnLeft" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_arrow_left"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnDown" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_arrow_down"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnRight" style="@style/Widget.AndroControl.Key.Tonal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="@string/key_arrow_right"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Navigation Drawer ===================== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drawer Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@color/surface_container">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@string/app_name"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_servers_title"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drawer_servers_subtitle"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_variant"/>

            <!-- Server List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/serverList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:clipToPadding="false"/>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQR"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_scan_qr"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconGravity="textStart"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddServer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_add_manually"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
