<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state — accent glow border -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/touchpad_pressed"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="@color/accent"/>
        </shape>
    </item>
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/touchpad_bg"/>
            <corners android:radius="24dp"/>
            <stroke android:width="2dp" android:color="@color/primary"/>
        </shape>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/touchpad_bg"
                android:endColor="@color/surface"/>
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="@color/touchpad_stroke"/>
        </shape>
    </item>
</selector>
