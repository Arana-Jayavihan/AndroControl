<?xml version="1.0" encoding="utf-8"?>
<!-- Edge scroll zone overlay for the touchpad: a faint translucent fill with a
     centered vertical rail to hint that this strip scrolls. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/scroll_zone_fill"/>
        </shape>
    </item>
    <item android:width="4dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/scroll_zone_rail"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>
